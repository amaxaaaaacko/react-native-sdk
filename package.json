{
  "name": "miamore-react-native-sdk",
  "version": "0.1.0",
  "description": "MiaMore React Native SDK: paywalls, subscription status, purchases (via react-native-iap), and attribution.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc -p tsconfig.build.json --module commonjs --outDir lib/commonjs",
    "build:esm": "tsc -p tsconfig.build.json --module es2020 --outDir lib/module",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --outDir lib/typescript",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf lib"
  },
  "keywords": [
    "react-native",
    "iap",
    "subscriptions",
    "miamore"
  ],
  "license": "UNLICENSED",
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-iap": ">=16.0.0",
    "@react-native-async-storage/async-storage": ">=1.0.0"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-iap": "^16.7.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
