{
  "name": "react-miamore",
  "version": "0.2.0",
  "description": "MiaMore React SDK: paywalls, subscription status, purchase linking and attribution over the MiaMore backend.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc -p tsconfig.build.json --module commonjs --moduleResolution node10 --outDir lib/commonjs",
    "build:esm": "tsc -p tsconfig.build.json --module es2020 --outDir lib/module",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --outDir lib/typescript",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf lib",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{ts,js}\""
  },
  "keywords": [
    "react",
    "subscriptions",
    "paywall",
    "miamore"
  ],
  "license": "UNLICENSED",
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
